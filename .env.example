# Flask
FLASK_APP=app:create_app
FLASK_DEBUG=1
# REQUIRED. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Initial admin (consumed by `flask init-db` only — both REQUIRED on first seed)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Database
DATABASE_URL=postgresql+psycopg://qms:qms@localhost:5432/qms

# Redis
REDIS_URL=redis://localhost:6379/0
# Per-deployment Redis key namespace. Set to e.g. "qms-staging" so a
# staging stack sharing a Redis with prod doesn't eat prod jobs.
REDIS_KEY_PREFIX=qms

# Locale
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=pl,en

# Auth
BCRYPT_LOG_ROUNDS=12
SESSION_LIFETIME_HOURS=8
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15
# Label shown by the user's authenticator app (Google Authenticator,
# 1Password, Aegis, etc). Doesn't affect verification — already-enrolled
# users still work after a rebrand.
TOTP_ISSUER=QMS
# Fernet key for TOTP-secret encryption-at-rest. Required when any
# user has TOTP enrolled. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENC_KEY=
# During key rotation, move the previous TOTP_ENC_KEY here (comma-separated
# for multiple historical keys). decrypt() tries the primary first then
# each old key in order. Run `flask totp-rotate-keys --apply` to bulk
# re-encrypt under the primary, then drop the old keys from this var.
TOTP_ENC_KEYS_OLD=

# Login rate-limit (per-IP). 10 requests / 60 seconds is the default;
# raise the cap or shorten the window from here without redeploying.
RATELIMIT_LOGIN_MAX=10
RATELIMIT_LOGIN_WINDOW=60

# CSRF
WTF_CSRF_TIME_LIMIT=3600

# Cookies (1 year for the lang cookie by default)
LANGUAGE_COOKIE_MAX_AGE=31536000

# Security headers
HSTS_MAX_AGE_SECONDS=31536000

# Compose / runtime ports (override to run two stacks side-by-side)
POSTGRES_PORT=5432
REDIS_PORT=6379
MQTT_PORT=1883
APP_PORT=8000
GUNICORN_WORKERS=4
GUNICORN_BIND=0.0.0.0:8000

# SMTP (EMAIL responder). Set SMTP_USE_TLS=1 for STARTTLS providers (Gmail, etc).
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=0
SMTP_FROM=qms@local

# ClickSend SMS (SMS responder). Username + API key from the dashboard's
# "API Credentials" section. Source = sender ID (alphanumeric, max 11 chars).
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=
CLICKSEND_SOURCE=QMS
CLICKSEND_BASE_URL=https://rest.clicksend.com/v3

# Training feature
# Public hostname embedded in SMS bodies (e.g. "https://qms.example.com").
# Without this, magic-link SMS bodies will only contain the path.
TRAINING_BASE_URL=
# Independent signing key for magic links — rotate to invalidate every
# outstanding link without disturbing web sessions. Falls back to SECRET_KEY.
TRAINING_LINK_SIGNING_KEY=
# Default per-course knobs (each course version can override).
TRAINING_DEFAULT_LINK_TTL_DAYS=7
TRAINING_DEFAULT_PASS_THRESHOLD=0.7
# How often the recurrence scheduler polls for due re-certs (seconds).
TRAINING_SCHEDULER_POLL_SECONDS=60
